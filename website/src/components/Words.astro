---
/** Splits a line into word masks so each word can rise into place. */
interface Props {
  text: string;
  start?: number;
}

const { text, start = 0 } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
---

{
  words.map((word, i) => (
    <>
      <span class="w">
        <span style={`--i:${start + i}`}>{word}</span>
      </span>{' '}
    </>
  ))
}
